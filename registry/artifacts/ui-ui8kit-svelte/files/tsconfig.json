{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "types": ["svelte", "vite/client"],
    "paths": {
      "@ui8kit/codegen/*": ["./packages/ui8kit-svelte/generated/*"]
    }
  },
  "include": ["src/**/*", "packages/ui8kit-svelte/generated/**/*"]
}
