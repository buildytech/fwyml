{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:fwyml:schema:harness-result:v0alpha1",
  "title": "FW harness result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "command", "exitCode"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "urn:fwyml:harness:v0alpha1"
    },
    "kind": {
      "type": "string",
      "const": "HarnessResult"
    },
    "command": { "type": "string" },
    "version": { "type": "string" },
    "inputs": {
      "type": "object",
      "additionalProperties": true
    },
    "exitCode": { "type": "integer" },
    "ok": { "type": "boolean" },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "severity"],
        "properties": {
          "code": { "type": "string" },
          "severity": {
            "type": "string",
            "enum": ["info", "warning", "error"]
          },
          "message": { "type": "string" },
          "id": { "type": "string" },
          "remediation": { "type": "string" }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
