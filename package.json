{
  "name": "fwyml",
  "version": "0.2.0",
  "description": "Generic compiler from an FW product manifest and registry into a user repository",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "fwyml": "./dist/cli.js"
  },
  "files": [
    "dist",
    "schemas",
    "registry/snapshot",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test test/*.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/buildytech/fwyml.git"
  },
  "bugs": {
    "url": "https://github.com/buildytech/fwyml/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "cli",
    "fwyml",
    "fw",
    "yaml"
  ],
  "author": {
    "name": "BuildY",
    "url": "https://github.com/buildytech"
  },
  "license": "Apache-2.0",
  "homepage": "https://github.com/buildytech/fwyml",
  "dependencies": {
    "ajv": "^8.17.1",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "^5.9.2"
  }
}
